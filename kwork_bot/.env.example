# ============================================================
#  kwork_bot — конфигурация. Скопируйте в `.env` и заполните.
#  Секреты в репозиторий не коммитятся (.env в .gitignore).
# ============================================================

# --- Telegram Bot API ---
BOT_TOKEN=
OWNER_ID=

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=1024
GEMINI_TEMPERATURE=0.7
GEMINI_RPS=0.5

# --- Ретраи (Gemini / Telegram) ---
RETRY_ATTEMPTS=4
RETRY_BASE_DELAY=2.0
RETRY_MAX_DELAY=30.0

# --- Kwork (Playwright) ---
KWORK_URL=https://kwork.ru/projects
KWORK_POLL_INTERVAL=180
KWORK_HEADLESS=true
KWORK_NAV_TIMEOUT_MS=30000
# Путь к сессии браузера (создаётся оператором вручную, см. README).
KWORK_STORAGE_STATE=data/storage_state.json

# --- Лицензия (коммерческая защита, Ed25519) ---
# LICENSE_KEY — подписанный токен клиента; LICENSE_PUBLIC_KEY — публичный ключ издателя.
LICENSE_KEY=
LICENSE_PUBLIC_KEY=
LICENSE_CACHE_TTL=86400

# --- База данных / логи ---
DATABASE_PATH=data/kwork_bot.db
DB_ECHO=false
LOG_LEVEL=INFO
LOG_DIR=logs
HEALTHCHECK_FILE=data/healthcheck.txt
