# ============================================================
#  LeadHunter — конфигурация. Скопируйте в `.env`.
#  Windows:  copy .env.example .env
# ============================================================

# --- Aiogram-бот (доставка карточек владельцу) ---
# Токен бота от @BotFather
BOT_TOKEN=
# Ваш личный Telegram user id (узнать: @userinfobot).
# ОБЯЗАТЕЛЬНО: без него бот никого не пустит, а админ-панель будет недоступна.
OWNER_ID=

# Открывает доступ ВСЕМ без выдачи прав — только для локальной отладки.
# В production оставьте false.
DEV_MODE=false

# --- AI-провайдеры (скоринг и генерация откликов) ---
# LeadHunter работает на бесплатных AI-провайдерах с автоматическим fallback.
# Порядок: OpenRouter → Groq → Ollama → Gemini. Достаточно ОДНОГО ключа.
# Проверить настройку: python check_ai.py

# Основной провайдер: openrouter / groq / ollama / gemini
AI_PROVIDER=openrouter

# OpenRouter (основной, бесплатные модели) — ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat:free

# Groq (быстрый бесплатный fallback) — ключ: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (локальные модели). Включите, если установлен `ollama serve`.
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Gemini (крайний fallback, если есть рабочий ключ) — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Общие параметры генерации (для всех провайдеров).
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7

# --- Источники лидов (RSS/Atom международных площадок) ---
# Список фидов через запятую. По умолчанию — публичные джоб-борды удалёнки.
# Для Upwork: откройте нужный поиск/Saved search → ссылка RSS и вставьте её сюда,
# например:
#   https://www.upwork.com/ab/feed/jobs/rss?q=python%20automation&sort=recency&securityToken=...&userUid=...&orgUid=...
FEEDS=https://weworkremotely.com/categories/remote-programming-jobs.rss, https://remoteok.com/remote-python-jobs.rss
# Как часто опрашивать фиды, сек.
FEED_POLL_INTERVAL=300

# --- AI Lead Scoring ---
# Профиль исполнителя: ИИ читает его и по смыслу оценивает заказы.
PROFILE_PATH=profile.md
# Оперативные настройки (min_score / min_budget / enabled_sources) правятся на ходу
# в этом YAML — без правки кода и перезапуска. Файл создастся сам при первом запуске.
RUNTIME_CONFIG_PATH=settings.yaml

# Отбор заказов делает ИИ (по смыслу + profile.md), а не ключевые слова.
# Пороги min_score / min_budget и активные источники — в settings.yaml.

# --- База данных (дедупликация, история, CRM) ---
DATABASE_PATH=leadhunter.db


# --- Kwork (kwork.ru и kwork.com) ---
# Выключен по умолчанию. Работает и без куки — тогда видна публичная выдача;
# с сессионной кукой заказов заметно больше.
# Как получить куку: залогиньтесь на Kwork в браузере → DevTools (F12) →
# вкладка Network → любой запрос → заголовок Cookie → скопируйте целиком.
KWORK_ENABLED=false
KWORK_COOKIE=
KWORK_COM_COOKIE=
KWORK_POLL_INTERVAL=300
KWORK_PAGES=1

# Курс для приведения рублёвых бюджетов к порогу в долларах. Приблизительный:
# нужен только для отсечки по бюджету, в карточке видна исходная сумма.
USD_RUB_RATE=95

# --- Production ---
# Файл лога с ротацией. Пусто = только stdout (docker logs / journalctl).
LOG_FILE=
LOG_MAX_BYTES=10485760
LOG_BACKUPS=5

# Сколько лидов обрабатываем параллельно. Больше — быстрее, но выше нагрузка
# на ИИ-провайдер и его лимиты.
PIPELINE_WORKERS=2
QUEUE_MAXSIZE=1000


# --- Прочие биржи ---
# Freelancer.com — единственная площадка с официальным публичным API,
# ключ не нужен.
FREELANCER_ENABLED=true

# PeoplePerHour и Guru парсятся по HTML публичных страниц.
# Кука не обязательна, но с ней видно больше заказов.
PPH_ENABLED=true
PPH_COOKIE=
GURU_ENABLED=true
GURU_COOKIE=

# Общие параметры опроса бирж.
SOURCE_POLL_INTERVAL=300
SOURCE_PAGES=1

# Лиды старше этого возраста не доходят до пользователей: на бирже под ними
# уже сотня откликов. 0 = отсечка выключена.
MAX_LEAD_AGE_HOURS=24
