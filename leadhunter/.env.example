# ============================================================
#  LeadHunter — конфигурация. Скопируйте в `.env`.
#  Windows:  copy .env.example .env
# ============================================================

# --- Aiogram-бот (доставка карточек владельцу) ---
# Токен бота от @BotFather
BOT_TOKEN=
# Ваш личный Telegram user id (узнать: @userinfobot). Карточки шлются только сюда.
OWNER_ID=

# --- Google Gemini (генерация откликов) ---
# Бесплатный ключ: https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=
# Модель Gemini. Читается из окружения — сменить можно здесь, без правок кода.
GEMINI_MODEL=gemini-1.5-flash

# --- Kwork (парсер проектов) ---
KWORK_ENABLED=true
KWORK_URL=https://kwork.ru/projects
# Как часто проверять новые проекты, сек.
KWORK_POLL_INTERVAL=180

# --- База данных (дедупликация и история) ---
DATABASE_PATH=leadhunter.db
