# ============================================================
#  LeadHunter — пример конфигурации. Скопируйте в `.env`.
#  cp .env.example .env
# ============================================================

# --- Telegram (Telethon userbot для мониторинга чатов) ---
# Получить api_id / api_hash: https://my.telegram.org → API development tools
TG_API_ID=0
TG_API_HASH=
TG_SESSION=leadhunter
# Телефон для первичной авторизации userbot (в формате +79991234567). Опционально.
TG_PHONE=
# Чаты для мониторинга через запятую: @username или числовой id.
TG_CHATS=@freelance_chat, @it_zakazy
# Ключевые слова (через запятую). Пусто = ловить все сообщения из чатов.
TG_KEYWORDS=нужен, ищу, требуется, разработать, парсер, бот, python

# --- Aiogram-бот (пуш карточек) ---
# Токен бота от @BotFather
BOT_TOKEN=
# Ваш личный Telegram user id (узнать: напишите боту /start после запуска,
# либо @userinfobot). Карточки шлются только сюда.
OWNER_ID=0

# --- Google Gemini (генерация откликов) ---
# Бесплатный ключ: https://aistudio.google.com → "Get API key" (без карты).
GEMINI_API_KEY=
# Модель. Если выбранная недоступна — попробуйте gemini-2.0-flash.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=1024
# Температура 0.0–2.0: выше = разнообразнее, ниже = строже/предсказуемее.
GEMINI_TEMPERATURE=0.7

# --- Устойчивость: ретраи и алёрты ---
# Сколько попыток вызвать Gemini при временных сбоях (429/5xx/сеть).
RETRY_ATTEMPTS=3
# Базовая задержка ретрая, сек (растёт экспоненциально: 2, 4, 8, …).
RETRY_BASE_DELAY=2.0
# Антиспам для алёртов: не чаще одного однотипного уведомления раз в N сек.
ALERT_COOLDOWN=300

# --- Kwork (Playwright-парсер) ---
KWORK_ENABLED=false
KWORK_LOGIN=
KWORK_PASSWORD=
KWORK_URL=https://kwork.ru/projects
KWORK_POLL_INTERVAL=180
KWORK_HEADLESS=true

# --- Фильтрация мусора ---
MIN_BUDGET=2000
JUNK_PHRASES=за отзыв, за отзывы, бесплатно, за лайк, за репост, тестовое бесплатно

# --- Прочее ---
DATABASE_PATH=leadhunter.db
LOG_LEVEL=INFO
