# ============================================================
#  LeadHunter — конфигурация. Скопируйте в `.env`.
#  Windows:  copy .env.example .env
# ============================================================

# --- Aiogram-бот (доставка карточек владельцу) ---
# Токен бота от @BotFather
BOT_TOKEN=
# Ваш личный Telegram user id (узнать: @userinfobot). Карточки шлются только сюда.
OWNER_ID=

# --- Google Gemini (скоринг и генерация откликов) ---
# Бесплатный ключ: https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=
# Модель Gemini. Читается из окружения — сменить можно здесь, без правок кода.
# ВНИМАНИЕ: gemini-1.5-flash снят и отдаёт 404 — используйте актуальную модель.
GEMINI_MODEL=gemini-2.0-flash
# Резервная модель: подхватывается, если основная недоступна (404) или квота (429).
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# --- Источники лидов (RSS/Atom международных площадок) ---
# Список фидов через запятую. По умолчанию — публичные джоб-борды удалёнки.
# Для Upwork: откройте нужный поиск/Saved search → ссылка RSS и вставьте её сюда,
# например:
#   https://www.upwork.com/ab/feed/jobs/rss?q=python%20automation&sort=recency&securityToken=...&userUid=...&orgUid=...
FEEDS=https://weworkremotely.com/categories/remote-programming-jobs.rss, https://remoteok.com/remote-python-jobs.rss
# Как часто опрашивать фиды, сек.
FEED_POLL_INTERVAL=300

# --- AI Lead Scoring ---
# Профиль исполнителя: ИИ читает его и по смыслу оценивает заказы.
PROFILE_PATH=profile.md
# Оперативные настройки (min_score / min_budget / enabled_sources) правятся на ходу
# в этом YAML — без правки кода и перезапуска. Файл создастся сам при первом запуске.
RUNTIME_CONFIG_PATH=settings.yaml

# Отбор заказов делает ИИ (по смыслу + profile.md), а не ключевые слова.
# Пороги min_score / min_budget и активные источники — в settings.yaml.

# --- База данных (дедупликация, история, CRM) ---
DATABASE_PATH=leadhunter.db
